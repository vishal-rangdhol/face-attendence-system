PORT=3000
COUCHBASE_HOST=localhost
COUCHBASE_QUERY_PORT=8093
COUCHBASE_ADMIN_PORT=8091
COUCHBASE_USER=attendance_backend
COUCHBASE_PASS=your_couchbase_password_here
COUCHBASE_BUCKET=attendance_system
COUCHBASE_SCOPE=app
DEFAULT_SIMILARITY_THRESHOLD=0.85

# Mandatory: 256-bit (32-byte) cryptographically secure secret used for AES-256-GCM biometric encryption at rest.
# Generate a new random secret with: openssl rand -hex 32
# CAUTION: Backend startup will fail if this key is missing or shorter than 32 characters.
# Never rotate or change this key after enrolling users without migrating previously stored templates.
BIOMETRIC_ENCRYPTION_KEY=
